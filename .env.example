# Copy to .env on the server (chmod 600). Loaded by the systemd unit via
# EnvironmentFile. Leave the SNOWFLAKE_* vars unset to run SQLite-only.

# --- Snowflake durable sink (optional) ---
SNOWFLAKE_ACCOUNT=orgname-accountname
SNOWFLAKE_USER=svc_zendesk_presence
SNOWFLAKE_PASSWORD=change-me
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=YOUR_DB
SNOWFLAKE_SCHEMA=YOUR_SCHEMA
# SNOWFLAKE_ROLE=YOUR_ROLE          # optional
# SNOWFLAKE_FLUSH_INTERVAL=15       # seconds between flushes (default 15)
# SNOWFLAKE_BATCH=500               # rows per batch (default 500)

# --- Self-hosted dashboard (deploy/dashboard.py) ---
# Gate the dashboard with a password (recommended, since :8501 is browser-reachable).
DASHBOARD_PASSWORD=change-me

# --- Webhook signature (optional) ---
# ZENDESK_WEBHOOK_SECRET=your-secret
